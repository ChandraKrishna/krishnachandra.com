# Browser-safe values only. Do not place Mailjet credentials in this file.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local-only name: use this when running Next.js on your computer.
# In GitHub Actions, create the repository variable CONTACT_ENDPOINT instead.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://your-worker.your-cloudflare-account.workers.dev/contact
PUBLIC_ANALYTICS_ID=G-XXXXXXXXXX

# Configure these as Production runtime Secrets in the Cloudflare Worker dashboard,
# never in this root .env.local file: MAILJET_API_KEY, MAILJET_SECRET_KEY,
# MAILJET_SENDER_EMAIL, MAILJET_SENDER_NAME, CONTACT_TO_EMAIL.
